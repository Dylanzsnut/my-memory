# Firebase Web config (from Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA Enterprise site key (optional in development; debug provider is used when absent)
VITE_RECAPTCHA_SITE_KEY=

# Firebase Remote Config overrides (safe defaults are used when unset)
VITE_CLOUD_MODEL=gemini-3.8-flash
VITE_DUPLICATE_THRESHOLD=0.97
VITE_RETRIEVAL_THRESHOLD=0.35
VITE_TRASH_RETENTION_DAYS=30

# Demo mode: explicit opt-in for synthetic sample captures (default false).
# Real Google sign-in accounts always start empty; the Demo option on the sign-in
# gate uses its own partitioned 'demo' workspace.
VITE_SEED_DEMO=false

# Firestore metadata sync (OFF by default). Scoped to /users/{uid}/captures/{id}
# when enabled for Google sign-in. Demo captures are never synced.
VITE_ENABLE_FIRESTORE_SYNC=false
