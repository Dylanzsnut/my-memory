# Firebase Web config (from Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA Enterprise site key (optional in development; debug provider is used when absent)
VITE_RECAPTCHA_SITE_KEY=

# Firebase Remote Config overrides (safe defaults are used when unset)
VITE_CLOUD_MODEL=gemini-3.8-flash
VITE_DUPLICATE_THRESHOLD=0.97
VITE_RETRIEVAL_THRESHOLD=0.35
VITE_TRASH_RETENTION_DAYS=30

# Demo mode: seed synthetic sample captures on first run so the UI is explorable
# without any personal data. Always true in this build; set false for a clean start.
VITE_SEED_DEMO=true

# Firestore metadata sync (OFF by default). Only enable after adding Firebase Auth
# and per-user Firestore rules; the shipped rules deny all access. When off, all
# captures stay entirely on this device. Demo captures are never synced.
VITE_ENABLE_FIRESTORE_SYNC=false
